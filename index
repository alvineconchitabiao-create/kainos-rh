<title>Kainos RH — Conseil en Ressources Humaines</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0f2440;
    --navy-deep:#0a1a30;
    --white:#ffffff;
    --ink:#12172090;
    --paper:#f6f7f9;
    --gold:#c8a85c;
    --line:#dfe3e8;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;scroll-padding-top:70px;}
  body{margin:0;background:var(--white);color:var(--navy-deep);font-family:'DM Sans',sans-serif;line-height:1.5;}
  h1,h2,h3{font-family:'Cormorant Garamond',serif;font-weight:600;margin:0;color:var(--navy-deep);}
  a{color:inherit;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}

  header{position:sticky;top:0;background:var(--white);border-bottom:1px solid var(--line);z-index:50;padding-top:env(safe-area-inset-top,0px);}
  nav{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;max-width:1080px;margin:0 auto;}
  .logo{font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:600;letter-spacing:.02em;}
  .logo span{color:var(--gold);}
  .navlinks{display:flex;gap:28px;font-size:.95rem;}
  .navlinks a{text-decoration:none;border-bottom:1px solid transparent;padding-bottom:2px;}
  .navlinks a:hover{border-color:var(--gold);}
  .navtoggle{display:none;background:none;border:none;font-size:1.5rem;cursor:pointer;}

  .hero{background:linear-gradient(160deg,var(--navy) 0%,var(--navy-deep) 100%);color:var(--white);padding:76px 0 64px;}
  .hero-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;}
  .hero h1{font-size:2.6rem;line-height:1.15;color:var(--white);max-width:14ch;}
  .hero p{margin-top:18px;max-width:44ch;opacity:.85;font-size:1.05rem;}
  .hero-cta{margin-top:28px;display:flex;gap:14px;flex-wrap:wrap;}
  .btn{display:inline-block;padding:13px 24px;border-radius:2px;text-decoration:none;font-size:.92rem;font-weight:500;transition:opacity .15s;}
  .btn:hover{opacity:.85;}
  .btn-gold{background:var(--gold);color:var(--navy-deep);}
  .btn-outline{border:1px solid rgba(255,255,255,.4);color:var(--white);}
  .hero-mark{border-left:1px solid rgba(255,255,255,.25);padding-left:32px;}
  .hero-mark .num{font-family:'Cormorant Garamond',serif;font-size:3rem;color:var(--gold);line-height:1;}
  .hero-mark .lbl{font-size:.85rem;opacity:.75;margin-top:6px;}
  .hero-mark + .hero-mark{margin-top:26px;}

  section{padding:64px 0;}
  .eyebrow{font-size:.8rem;color:var(--gold);margin-bottom:8px;}
  .section-head{max-width:60ch;margin-bottom:36px;}
  .section-head h2{font-size:2rem;}
  .section-head p{margin-top:10px;color:#3d4552;}

  /* A la une */
  #une{background:var(--paper);}
  .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .news-card{background:var(--white);border:1px solid var(--line);padding:22px;text-decoration:none;display:flex;flex-direction:column;gap:10px;transition:border-color .15s,transform .15s;}
  .news-card:hover{border-color:var(--gold);transform:translateY(-2px);}
  .news-tag{font-size:.72rem;color:var(--navy);background:#e9edf3;padding:3px 9px;width:fit-content;border-radius:2px;}
  .news-card h3{font-size:1.15rem;color:var(--navy-deep);}
  .news-card p{font-size:.88rem;color:#4b5563;margin:0;}
  .news-card .goto{margin-top:auto;font-size:.82rem;color:var(--navy);}

  /* Services */
  .service{border-top:1px solid var(--line);padding:44px 0;display:grid;grid-template-columns:.4fr 1.6fr;gap:36px;scroll-margin-top:80px;}
  .service:last-child{border-bottom:1px solid var(--line);}
  .service-label{font-size:1.4rem;}
  .service-label .sub{display:block;font-family:'DM Sans',sans-serif;font-size:.82rem;color:#6b7280;margin-top:6px;font-weight:400;}
  .service-cols{display:grid;grid-template-columns:1fr 1fr;gap:30px;}
  .service-cols h4{font-size:.78rem;text-transform:none;letter-spacing:.01em;color:var(--navy);margin-bottom:10px;font-family:'DM Sans',sans-serif;font-weight:700;}
  .service-cols ul{margin:0;padding-left:18px;font-size:.92rem;color:#374151;}
  .service-cols li{margin-bottom:6px;}
  .service-photo{width:100%;height:200px;object-fit:cover;margin-bottom:18px;}

  /* Templates */
  #templates{background:var(--navy-deep);color:var(--white);}
  #templates .section-head p{color:rgba(255,255,255,.7);}
  #templates .eyebrow{color:var(--gold);}
  .tpl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .tpl-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);padding:22px;display:flex;flex-direction:column;gap:10px;}
  .tpl-card h3{color:var(--white);font-size:1.2rem;}
  .tpl-card p{font-size:.88rem;color:rgba(255,255,255,.65);margin:0;flex-grow:1;}
  .tpl-price{font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--gold);margin-top:4px;}
  .tpl-buy{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
  .tpl-buy a{font-size:.78rem;padding:8px 12px;border:1px solid rgba(255,255,255,.3);text-decoration:none;color:var(--white);border-radius:2px;}
  .tpl-buy a:hover{border-color:var(--gold);color:var(--gold);}
  .tpl-note{margin-top:30px;font-size:.85rem;color:rgba(255,255,255,.55);}

  /* Contact */
  #contact{background:var(--paper);}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;}
  .contact-grid h3{font-size:1.3rem;margin-bottom:14px;}
  .contact-grid p{margin:0 0 8px;font-size:.95rem;}
  .contact-grid a.email{color:var(--navy);}

  footer{padding:26px 0;text-align:center;font-size:.8rem;color:#6b7280;border-top:1px solid var(--line);}

  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --white:#12161c; --paper:#171c23; --navy-deep:#080d14; --line:#2a303a; --ink:#e5e7eb;
    }
    :root:not([data-theme="light"]) body{color:#e5e7eb;}
    :root:not([data-theme="light"]) h1,:root:not([data-theme="light"]) h2,:root:not([data-theme="light"]) h3{color:#f3f4f6;}
    :root:not([data-theme="light"]) .news-card, :root:not([data-theme="light"]) .news-card p{color:#cbd5e1;}
    :root:not([data-theme="light"]) .service-cols ul, :root:not([data-theme="light"]) .section-head p, :root:not([data-theme="light"]) .contact-grid p{color:#cbd5e1;}
    :root:not([data-theme="light"]) .news-tag{background:#232a35;color:#dfe3e8;}
  }

  @media (max-width:820px){
    .hero-inner{grid-template-columns:1fr;}
    .hero-mark{border-left:none;padding-left:0;border-top:1px solid rgba(255,255,255,.25);padding-top:18px;}
    .news-grid,.tpl-grid{grid-template-columns:1fr;}
    .service{grid-template-columns:1fr;}
    .service-cols{grid-template-columns:1fr;}
    .contact-grid{grid-template-columns:1fr;}
    .navlinks{display:none;position:absolute;top:100%;left:0;right:0;background:var(--white);flex-direction:column;gap:0;border-bottom:1px solid var(--line);}
    .navlinks.open{display:flex;}
    .navlinks a{padding:14px 24px;border-bottom:1px solid var(--line);}
    .navtoggle{display:block;}
  }

  .service-cta{margin-top:16px;}
  .service-cta a{font-size:.85rem;color:var(--navy);text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:2px;cursor:pointer;}
  .service-cta a:hover{color:var(--gold);}
  #contact-modal{display:none;position:fixed;inset:0;background:rgba(10,26,48,.6);z-index:100;align-items:center;justify-content:center;padding:20px;}
  #contact-modal.open{display:flex;}
  .modal-box{background:var(--white);max-width:440px;width:100%;padding:32px;position:relative;}
  .modal-box h3{margin-bottom:6px;}
  .modal-box p{font-size:.85rem;color:#6b7280;margin-bottom:18px;}
  .modal-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:1.3rem;cursor:pointer;color:#6b7280;}
  .modal-box label{display:block;font-size:.8rem;margin-bottom:5px;color:var(--navy-deep);}
  .modal-box input,.modal-box textarea{width:100%;padding:9px;border:1px solid var(--line);margin-bottom:14px;font-family:inherit;font-size:.9rem;}
  .modal-box textarea{min-height:90px;resize:vertical;}
  .modal-box button[type=submit]{width:100%;padding:12px;background:var(--navy);color:var(--white);border:none;font-size:.9rem;cursor:pointer;}
  .modal-box button[type=submit]:hover{background:var(--navy-deep);}
</style>
</head>
