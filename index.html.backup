  <a href="#vision" class="mm-link">Notre vision</a>
  <a href="#contact" class="mm-link">Contact</a>
  <div class="mm-divider"></div>
  <a href="#contact" class="mm-link mm-cta">Parlez-nous de votre projet</a>
</div>

<section class="hero">
  <div class="hbg"></div><div class="hgrid"></div>
  <div class="hglow1"></div><div class="hglow2"></div>
  <div class="hline"></div>
  <div class="hi">
    <div class="htag"><span class="hdot"></span>Cabinet de Gestion RH · Cotonou, Bénin</div>
    <h1>L'excellence RH<br>au service de votre<br><em>croissance.</em></h1>
    <p class="hdesc">KAINOS RH est le cabinet de référence en gestion des ressources humaines en Afrique de l'Ouest. Cinq services complémentaires pour transformer vos RH en levier de performance.</p>
    <div class="hbtns">
      <a href="#services" class="btn-or">Découvrir nos services →</a>
      <a href="#contact" class="btn-gh">Nous contacter</a>
    </div>
    <div class="hmetrics">
      <div class="hm"><div class="hm-val">5</div><div class="hm-label">Services spécialisés</div></div>
      <div class="hm"><div class="hm-val">200+</div><div class="hm-label">Entreprises accompagnées</div></div>
      <div class="hm"><div class="hm-val">95%</div><div class="hm-label">Satisfaction client</div></div>
    </div>
  </div>
</section>

<div class="mband">
  <div class="mbi">
    <div class="mb"><div class="mb-val">5</div><div class="mb-label">Services spécialisés</div></div>
    <div class="mb"><div class="mb-val">200<sup>+</sup></div><div class="mb-label">Entreprises accompagnées</div></div>
    <div class="mb"><div class="mb-val">22</div><div class="mb-label">Outils RH digitaux</div></div>
    <div class="mb"><div class="mb-val">15<sup>+</sup></div><div class="mb-label">Secteurs couverts</div></div>
    <div class="mb"><div class="mb-val">95<sup>%</sup></div><div class="mb-label">Taux de satisfaction</div></div>
  </div>
</div>

<!-- BANDE PHOTOS -->
<div style="display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;height:340px;overflow:hidden;position:relative;">
  <div style="overflow:hidden;position:relative;">
    <img src="data:image/jpeg;base64," alt="Professionnelle RH" style="width:100%;height:100%;object-fit:cover;object-position:center top;filter:brightness(.85);"/>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(7,20,40,.7));"></div>
    <div style="position:absolute;bottom:1.25rem;left:1.25rem;font-family:Syne,sans-serif;font-size:13px;font-weight:700;color:#fff;">Excellence RH</div>
  </div>
  <div style="overflow:hidden;">
    <img src="data:image/jpeg;base64," alt="Équipe" style="width:100%;height:100%;object-fit:cover;filter:brightness(.85);"/>
  </div>
  <div style="overflow:hidden;">
    <img src="data:image/jpeg;base64," alt="Bureau" style="width:100%;height:100%;object-fit:cover;filter:brightness(.85);"/>
  </div>
  <div style="overflow:hidden;">
    <img src="data:image/jpeg;base64," alt="Expert" style="width:100%;height:100%;object-fit:cover;object-position:center top;filter:brightness(.85);"/>
  </div>
</div>

<section id="services">
  <div class="si">
    <div class="fu">
      <div class="sey">Nos 5 services</div>
      <h2 class="stit">Cinq expertises,<br>un seul <em>cabinet.</em></h2>
      <p class="sdesc">KAINOS RH regroupe des services complémentaires pour couvrir l'intégralité de vos besoins RH.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-bottom:1.5rem;">
      <div class="sc fu" onclick="ouvrirModal('elite')">
        <div class="sc-bar" style="background:var(--or);"></div>
        <div class="sc-body">
          <div class="sc-num">Service 01</div><div class="sc-icon">🏛️</div>
          <div class="sc-name">Elite RH Consulting</div>
          <div class="sc-tagline" style="color:var(--or);">Conseil · Audit · Formation</div>
          <div class="sc-desc">Accompagnement stratégique des dirigeants et DRH dans la transformation de leur fonction RH.</div>
          <div class="sc-feats">
            <div class="sc-feat">Conseil RH stratégique & opérationnel</div>
            <div class="sc-feat">Audit social & diagnostic RH complet</div>
            <div class="sc-feat">Formation & développement des équipes</div>
          </div>
        </div>
        <div class="sc-footer">
          <a href="#contact" class="sc-link" style="color:var(--or);">💬 Parlez-nous de votre projet</a>
          <span class="sc-badge st-on">● Actif</span>
        </div>
      </div>
      <div class="sc fu" style="transition-delay:.08s;" onclick="ouvrirModal('jobfit')">
        <div class="sc-bar" style="background:var(--rd);"></div>
        <div class="sc-body">
          <div class="sc-num">Service 02</div><div class="sc-icon">🎯</div>
          <div class="sc-name">Jobfit</div>
          <div class="sc-tagline" style="color:var(--rd);">Recrutement & Mise en relation</div>
          <div class="sc-desc">Connexion entre entreprises et talents pour des missions courtes ou longues, dans tous les domaines.</div>
          <div class="sc-feats">
            <div class="sc-feat">Recrutement & sélection de profils clés</div>
            <div class="sc-feat">Mise en relation consultants/missions</div>
            <div class="sc-feat">Mise à disposition d'experts</div>
          </div>
        </div>
        <div class="sc-footer">
          <span class="sc-link" style="color:var(--rd);">En savoir plus →</span>
          <span class="sc-badge st-on">● Actif</span>
        </div>
      </div>
      <div class="sc fu" style="transition-delay:.16s;" onclick="ouvrirModal('rhenline')">
        <div class="sc-bar" style="background:var(--bleu);"></div>
        <div class="sc-body">
          <div class="sc-num">Service 03</div><div class="sc-icon">💻</div>
          <div class="sc-name">Votre RH en ligne</div>
          <div class="sc-tagline" style="color:var(--bleu);">Externalisation RH complète</div>
          <div class="sc-desc">Externalisez votre gestion RH. Paie, administration, congés — tout géré à distance avec rigueur.</div>
          <div class="sc-feats">
            <div class="sc-feat">Externalisation RH & DRH à temps partagé</div>
            <div class="sc-feat">Paie, déclarations sociales & fiscales</div>
            <div class="sc-feat">Administration et conformité légale</div>
          </div>
        </div>
        <div class="sc-footer">
          <span class="sc-link" style="color:var(--bleu);">En savoir plus →</span>
          <span class="sc-badge st-on">● Actif</span>
        </div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;max-width:840px;margin:0 auto;">
      <div class="sc fu" style="transition-delay:.24s;" onclick="ouvrirModal('pae')">
        <div class="sc-bar" style="background:linear-gradient(90deg,#F06292,#A78BFA);"></div>
        <div class="sc-body">
          <div class="sc-num">Service 04</div><div class="sc-icon">❤️</div>
          <div class="sc-name">PAE</div>
          <div class="sc-tagline" style="color:#F06292;">Programme Aide aux Employés</div>
          <div class="sc-desc">Programme global de bien-être couvrant 9 services autour de 4 axes de santé et développement.</div>
          <div class="sc-feats">
            <div class="sc-feat">Psychologue, gestion du stress & conflits</div>
            <div class="sc-feat">Formation managers & leadership</div>
            <div class="sc-feat">Coach sportif, nutritionniste & soins</div>
          </div>
        </div>
        <div class="sc-footer">
          <span class="sc-link" style="color:#F06292;">En savoir plus →</span>
          <span class="sc-badge st-on">● Actif</span>
        </div>
      </div>
      <div class="sc fu" style="transition-delay:.32s;" onclick="ouvrirModal('stratos')">
        <div class="sc-bar" style="background:var(--vl);"></div>
        <div class="sc-body">
          <div class="sc-num">Service 05</div><div class="sc-icon">🚀</div>
          <div class="sc-name">STRATOS</div>
          <div class="sc-tagline" style="color:var(--vl);">SaaS RH · Objectifs · Performances</div>
          <div class="sc-desc">Plateforme SaaS pour piloter vos objectifs OKR, évaluer les performances de chaque collaborateur.</div>
          <div class="sc-feats">
            <div class="sc-feat">Suivi des objectifs (OKR) en temps réel</div>
            <div class="sc-feat">Gestion des performances & équipes</div>
            <div class="sc-feat">Budget RH & analytics décisionnels</div>
          </div>
        </div>
        <div class="sc-footer">
          <span class="sc-link" style="color:var(--vl);">En savoir plus →</span>
          <span class="sc-badge st-on">● Actif</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="vision">
  <div class="vi">
    <div class="fu">
      <div class="sey">Notre vision</div>
      <h2 class="stit">Pourquoi<br><em>KAINOS RH</em> ?</h2>
      <p style="font-size:14px;color:var(--gr);line-height:1.85;font-weight:300;margin-bottom:1.5rem;">KAINOS — du grec ancien, "nouveau, innovant" — incarne notre conviction : les RH africaines méritent des solutions pensées pour leurs réalités.</p>
      <p style="font-size:14px;color:var(--gr);line-height:1.85;font-weight:300;margin-bottom:2rem;">Nous connaissons le Code du Travail béninois, la CNSS, les réalités des PME et des multinationales de la région.</p>
      <a href="#contact" class="btn-or">Démarrer avec KAINOS RH →</a>
    </div>
    <div class="vr">
      <div class="vc fu"><div class="vc-ico">🌍</div><div class="vc-tit">Expertise africaine</div><div class="vc-desc">Maîtrise parfaite du droit social béninois et OHADA. Nos solutions intègrent les spécificités légales et culturelles locales.</div></div>
      <div class="vc fu" style="transition-delay:.06s;"><div class="vc-ico">🔗</div><div class="vc-tit">Écosystème intégré</div><div class="vc-desc">5 services complémentaires qui travaillent ensemble, sans rupture ni friction pour votre entreprise.</div></div>
      <div class="vc fu" style="transition-delay:.12s;"><div class="vc-ico">⚡</div><div class="vc-tit">Réactivité & proximité</div><div class="vc-desc">Réponse sous 48h, accompagnement terrain, interlocuteur dédié.</div></div>
      <div class="vc fu" style="transition-delay:.18s;"><div class="vc-ico">📈</div><div class="vc-tit">Impact mesurable</div><div class="vc-desc">Des objectifs clairs, des KPI suivis, des résultats documentés pour votre organisation.</div></div>
    </div>
  </div>
</section>

<section id="contact">
  <div class="coi">
    <div class="fu">
      <div class="sey">Contact</div>
      <h2 class="stit">Parlons de votre<br>projet <em>RH.</em></h2>
      <p style="font-size:14px;color:var(--gr);line-height:1.85;font-weight:300;margin-bottom:2rem;">Que vous souhaitiez un conseil, externaliser vos RH ou simplement en savoir plus — notre équipe est disponible.</p>
      <div class="ci"><div class="ci-ico">📍</div><div><div class="ci-lbl">Adresse</div><div class="ci-val">Cotonou, République du Bénin</div></div></div>
      <div class="ci"><div class="ci-ico">📞</div><div><div class="ci-lbl">Téléphone</div><div class="ci-val">+229 01 99 34 47 39</div></div></div>
      <div class="ci"><div class="ci-ico">✉️</div><div><div class="ci-lbl">Email</div><div class="ci-val">contact@kainosrh.com</div></div></div>
    </div>
    <div class="cf fu" style="transition-delay:.12s;">
      <div class="cf-tit">✉️ Envoyez-nous un message</div>
      <div class="fg">
        <div class="ff"><label class="ffl">Nom & Prénom *</label><input class="ffi" type="text" id="c-nom" placeholder="Ex: DOSSOU Jean"/></div>
        <div class="ff"><label class="ffl">Entreprise</label><input class="ffi" type="text" id="c-ent" placeholder="Ex: ACME Sarl"/></div>
        <div class="ff"><label class="ffl">Téléphone *</label><input class="ffi" type="tel" id="c-tel" placeholder="+229 01 XX XX XX XX"/></div>
        <div class="ff"><label class="ffl">Email</label><input class="ffi" type="email" id="c-email" placeholder="jean@acme.bj"/></div>
        <div class="ff ff-full"><label class="ffl">Service concerné</label>
          <select class="ffi" id="c-service">
            <option value="">— Sélectionner —</option>
            <option>Elite RH Consulting (Conseil, Audit, Formation)</option>
            <option>Jobfit (Recrutement & Mise en relation)</option>
            <option>Votre RH en ligne (Externalisation RH)</option>
            <option>PAE (Programme Aide aux Employés)</option>
            <option>STRATOS (SaaS RH)</option>
            <option>Renseignement général</option>
          </select>
        </div>
        <div class="ff ff-full"><label class="ffl">Message</label><textarea class="ffi" id="c-msg" rows="3" placeholder="Décrivez votre besoin..."></textarea></div>
      </div>
      <button class="cf-btn" onclick="envoyer()">Envoyer le message →</button>
    </div>
  </div>
</section>

<footer>
  <div class="fi">
    <div class="fg-top">
      <div>
        <div class="flogo">KAINOS <span>RH</span></div>
        <div class="ftag">Cabinet de gestion RH de référence en Afrique de l'Ouest.<br>Conseil · Externalisation · Technologie · Recrutement.</div>
        <div style="font-size:11px;color:#A0B0D0;">📍 Cotonou, Bénin · contact@kainosrh.com</div>
      </div>
