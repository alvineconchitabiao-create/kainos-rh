<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>KAINOS RH — Cabinet de Gestion RH · Cotonou, Bénin</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg-main: #FFFFFF;
  --bg-sec: #F8FAFC;
  --bg-card: #FFFFFF;
  --text-main: #0F172A;
  --text-muted: #475569;
  --text-light: #94A3B8;
  --accent: #D4AF37; /* Refined Gold */
  --accent-hover: #B5952F;
  --accent-light: rgba(212, 175, 55, 0.1);
  --border: #E2E8F0;
  --border-light: #F1F5F9;
  --fd: 'Outfit', sans-serif;
  --fb: 'Inter', sans-serif;
  --shadow-nav: 0 4px 20px rgba(0,0,0,0.03);
  --shadow-card: 0 10px 30px rgba(0,0,0,0.04);
  --shadow-hover: 0 20px 40px rgba(0,0,0,0.08);
  --shadow-glow: 0 8px 25px rgba(212, 175, 55, 0.25);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--fb);background:var(--bg-main);color:var(--text-muted);overflow-x:hidden;font-size:15px;line-height:1.6;}
::-webkit-scrollbar{width:4px;}::-webkit-scrollbar-thumb{background:var(--accent);border-radius:4px;}
a{text-decoration:none;color:inherit;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;height:72px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-light);transition:all .3s ease;}
nav.scrolled{box-shadow:var(--shadow-nav);background:rgba(255,255,255,.98);}
.nav-brand{display:flex;align-items:center;gap:12px;}
.nav-emblem{width:32px;height:32px;background:var(--accent-light);color:var(--accent);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:16px;}
.nav-name{font-family:var(--fd);font-size:17px;font-weight:700;letter-spacing:-0.02em;color:var(--text-main);}
.nav-name span{color:var(--accent);}
.nav-links{display:flex;align-items:center;gap:2.5rem;}
.nav-links a{font-size:14px;font-weight:500;color:var(--text-muted);transition:color .2s ease;}
.nav-links a:hover{color:var(--accent);}
.nav-cta{background:var(--accent)!important;color:#FFFFFF!important;padding:10px 24px;border-radius:var(--radius-sm);font-family:var(--fd);font-size:13px;font-weight:600!important;letter-spacing:0.02em;transition:all .3s ease!important;box-shadow:var(--shadow-glow);}
.nav-cta:hover{background:var(--accent-hover)!important;transform:translateY(-2px)!important;}

/* HAMBURGER BUTTON */
.nav-hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;cursor:pointer;padding:8px;border-radius:var(--radius-sm);border:none;background:transparent;z-index:300;}
.nav-hamburger span{display:block;width:22px;height:2px;background:var(--text-main);border-radius:2px;transition:all .35s cubic-bezier(0.16,1,0.3,1);}
.nav-hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.nav-hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0);}
.nav-hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

/* MOBILE MENU OVERLAY */
.mobile-menu{position:fixed;top:0;left:0;right:0;bottom:0;z-index:250;background:rgba(255,255,255,0.97);backdrop-filter:blur(16px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;opacity:0;pointer-events:none;transition:opacity .3s ease;}
.mobile-menu.open{opacity:1;pointer-events:all;}
.mobile-menu a{font-family:var(--fd);font-size:1.6rem;font-weight:700;color:var(--text-main);padding:1rem 2rem;letter-spacing:-0.02em;opacity:0;transform:translateY(20px);transition:transform .4s ease,opacity .4s ease,color .2s ease;}
.mobile-menu.open a{transform:translateY(0);opacity:1;}
.mobile-menu.open a:nth-child(1){transition-delay:0.05s;}
.mobile-menu.open a:nth-child(2){transition-delay:0.10s;}
.mobile-menu.open a:nth-child(3){transition-delay:0.15s;}
.mobile-menu.open a:nth-child(5){transition-delay:0.22s;}
.mobile-menu a:hover{color:var(--accent);}
.mm-divider{width:40px;height:2px;background:var(--accent);border-radius:2px;margin:1.5rem 0;opacity:0;transition:opacity .4s ease .18s;}
.mobile-menu.open .mm-divider{opacity:1;}
.mm-cta{background:var(--accent);color:#FFFFFF!important;padding:14px 40px!important;border-radius:var(--radius-sm)!important;font-size:1rem!important;box-shadow:var(--shadow-glow);margin-top:.5rem;}

/* HAMBURGER */
.nav-hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;border-radius:var(--radius-sm);border:none;background:transparent;z-index:300;}
.nav-hamburger span{display:block;width:22px;height:2px;background:var(--text-main);border-radius:2px;transition:all .35s cubic-bezier(0.16,1,0.3,1);}
.nav-hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.nav-hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0);}
.nav-hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

/* MOBILE MENU OVERLAY */
.mobile-menu{position:fixed;inset:0;z-index:250;background:rgba(255,255,255,0.97);backdrop-filter:blur(16px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;opacity:0;pointer-events:none;transition:opacity .35s ease;}
.mobile-menu.open{opacity:1;pointer-events:all;}
.mobile-menu a{font-family:var(--fd);font-size:1.6rem;font-weight:700;color:var(--text-main);padding:1rem 2rem;letter-spacing:-0.02em;transition:color .2s;transform:translateY(20px);opacity:0;transition:transform .4s ease, opacity .4s ease, color .2s ease;}
.mobile-menu.open a{transform:translateY(0);opacity:1;}
.mobile-menu.open a:nth-child(1){transition-delay:0.05s;}
.mobile-menu.open a:nth-child(2){transition-delay:0.1s;}
.mobile-menu.open a:nth-child(3){transition-delay:0.15s;}
.mobile-menu.open a:nth-child(4){transition-delay:0.2s;}
.mobile-menu a:hover{color:var(--accent);}
.mobile-menu .mm-divider{width:40px;height:2px;background:var(--accent);border-radius:2px;margin:1.5rem 0;}
.mobile-menu .mm-cta{background:var(--accent);color:#FFFFFF!important;padding:14px 40px;border-radius:var(--radius-sm);font-size:1rem!important;font-weight:600;letter-spacing:0.02em;box-shadow:var(--shadow-glow);margin-top:.5rem;}

/* HERO */
.hero{min-height:90vh;position:relative;display:flex;align-items:center;padding:140px 5vw 80px;overflow:hidden;background:var(--bg-main);}
.hbg{position:absolute;inset:0;background:radial-gradient(circle at top right, var(--bg-sec) 0%, var(--bg-main) 70%);}
.hgrid{position:absolute;inset:0;background-image:linear-gradient(var(--border-light) 1px,transparent 1px),linear-gradient(90deg,var(--border-light) 1px,transparent 1px);background-size:80px 80px;opacity:0.6;}
.hglow1{position:absolute;top:-10%;right:-5%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,var(--accent-light) 0%,transparent 60%);pointer-events:none;filter:blur(40px);}
.hline{display:none;}
.hi{position:relative;z-index:1;max-width:1100px;margin:0 auto;width:100%;text-align:center;display:flex;flex-direction:column;align-items:center;}
.htag{display:inline-flex;align-items:center;gap:8px;background:var(--accent-light);border:1px solid rgba(212,175,55,0.2);border-radius:30px;padding:6px 20px;font-family:var(--fb);font-size:12px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--accent-hover);margin-bottom:2rem;}
.hdot{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:blink 2s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.4;}}
h1{font-family:var(--fd);font-size:clamp(2.5rem,5vw,3.8rem);font-weight:800;line-height:1.1;letter-spacing:-.03em;margin-bottom:1.5rem;color:var(--text-main);max-width:850px;}
h1 em{font-style:normal;color:var(--accent);position:relative;display:inline-block;}
h1 em::after{content:'';position:absolute;bottom:5px;left:0;right:0;height:8px;background:var(--accent-light);z-index:-1;border-radius:4px;}
.hdesc{font-size:16px;color:var(--text-muted);line-height:1.8;font-weight:400;margin-bottom:3rem;max-width:650px;}
.hbtns{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-bottom:4rem;}
.btn-or{background:var(--accent);color:#FFFFFF;padding:14px 32px;border-radius:var(--radius-sm);font-family:var(--fd);font-size:14px;font-weight:600;letter-spacing:0.02em;transition:all .3s ease;display:inline-flex;align-items:center;gap:8px;box-shadow:var(--shadow-glow);}
.btn-or:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow: 0 12px 30px rgba(212, 175, 55, 0.3);}
.btn-gh{background:var(--bg-card);color:var(--text-main);padding:14px 32px;border-radius:var(--radius-sm);font-family:var(--fd);font-size:14px;font-weight:600;border:1px solid var(--border);letter-spacing:0.02em;transition:all .3s ease;display:inline-flex;align-items:center;gap:8px;box-shadow:var(--shadow-sm);}
.btn-gh:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px);box-shadow:var(--shadow-card);}
.hmetrics{display:flex;gap:3rem;flex-wrap:wrap;justify-content:center;}
.hm{display:flex;flex-direction:column;align-items:center;padding:0 1rem;}
.hm-val{font-family:var(--fd);font-size:2.2rem;font-weight:800;color:var(--text-main);line-height:1.2;}
.hm-label{font-size:13px;font-weight:500;color:var(--text-light);margin-top:.2rem;}

/* MBAND */
.mband{background:var(--bg-sec);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);padding:3.5rem 5vw;}
.mbi{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);gap:2rem;}
.mb{text-align:center;position:relative;}
.mb:not(:last-child)::after{content:'';position:absolute;right:-1rem;top:20%;bottom:20%;width:1px;background:var(--border);}
.mb-val{font-family:var(--fd);font-size:2.5rem;font-weight:800;color:var(--accent);line-height:1;}
.mb-val sup{font-size:1.2rem;}
.mb-label{font-size:13px;font-weight:500;color:var(--text-muted);margin-top:.5rem;line-height:1.4;}

/* SERVICES */
#services{padding:120px 5vw;background:var(--bg-main);}
.si{max-width:1200px;margin:0 auto;}
.sey{font-family:var(--fb);font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);margin-bottom:.75rem;}
.stit{font-family:var(--fd);font-size:clamp(2rem,3.5vw,2.5rem);font-weight:800;line-height:1.2;letter-spacing:-.02em;margin-bottom:1.5rem;color:var(--text-main);}
.stit em{font-style:normal;color:var(--accent);}
.sdesc{font-size:16px;color:var(--text-muted);line-height:1.8;max-width:650px;margin-bottom:4rem;}
.sc{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;transition:all .4s cubic-bezier(0.16, 1, 0.3, 1);position:relative;display:flex;flex-direction:column;cursor:pointer;box-shadow:var(--shadow-nav);}
.sc:hover{transform:translateY(-8px);box-shadow:var(--shadow-hover);border-color:rgba(212, 175, 55, 0.3);}
.sc-bar{height:4px;background:var(--border-light);transition:background .3s;}
.sc:hover .sc-bar{background:var(--accent);}
.sc-body{padding:2.5rem 2rem 2rem;flex:1;}
.sc-num{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:0.05em;color:var(--text-light);margin-bottom:1.5rem;display:inline-block;background:var(--bg-sec);padding:4px 10px;border-radius:6px;}
.sc-icon{font-size:2.5rem;margin-bottom:1.5rem;display:inline-block;padding:12px;background:var(--accent-light);border-radius:var(--radius-md);color:var(--accent);}
.sc-name{font-family:var(--fd);font-size:1.4rem;font-weight:700;color:var(--text-main);margin-bottom:.5rem;}
.sc-tagline{font-size:13px;font-weight:500;color:var(--accent);margin-bottom:1.2rem;}
.sc-desc{font-size:14px;color:var(--text-muted);line-height:1.7;}
.sc-feats{margin-top:1.5rem;display:flex;flex-direction:column;gap:.6rem;padding-top:1.5rem;border-top:1px solid var(--border-light);}
.sc-feat{font-size:13px;color:var(--text-muted);display:flex;align-items:flex-start;gap:8px;line-height:1.5;}
.sc-feat::before{content:'✓';font-weight:700;color:var(--accent);flex-shrink:0;}
.sc-footer{padding:1.5rem 2rem;background:var(--bg-sec);border-top:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;}
.sc-link{display:inline-flex;align-items:center;gap:6px;font-family:var(--fd);font-size:13px;font-weight:600;letter-spacing:0.02em;transition:all .3s;color:var(--text-main);}
.sc-link:hover{gap:10px;color:var(--accent);}
.sc-badge{font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;}
.st-on{background:rgba(34,212,138,.1);color:#059669;}

/* VISION */
#vision{padding:120px 5vw;background:var(--bg-sec);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);}
.vi{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center;}
.vr{display:flex;flex-direction:column;gap:1.5rem;}
.vc{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:2rem;transition:all .3s ease;box-shadow:var(--shadow-nav);}
.vc:hover{border-color:var(--accent);transform:translateX(5px);box-shadow:var(--shadow-card);}
.vc-ico{font-size:1.8rem;margin-bottom:1rem;color:var(--accent);}
.vc-tit{font-family:var(--fd);font-size:1.1rem;font-weight:700;color:var(--text-main);margin-bottom:.5rem;}
.vc-desc{font-size:14px;color:var(--text-muted);line-height:1.7;}

/* CONTACT */
#contact{padding:120px 5vw;background:var(--bg-main);}
.coi{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:6rem;align-items:start;}
.cf{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:3rem;box-shadow:var(--shadow-card);}
.cf-tit{font-family:var(--fd);font-size:1.4rem;font-weight:700;color:var(--text-main);margin-bottom:2rem;}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem;}
.ff{display:flex;flex-direction:column;gap:8px;}
.ffl{font-size:12px;font-weight:600;color:var(--text-muted);}
.ffi{background:var(--bg-sec);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-main);font-family:var(--fb);font-size:14px;padding:12px 16px;outline:none;transition:all .3s;}
.ffi:focus{border-color:var(--accent);background:var(--bg-main);box-shadow:0 0 0 3px var(--accent-light);}
.ff-full{grid-column:1/-1;}
.cf-btn{width:100%;padding:16px;background:var(--accent);color:#FFFFFF;border:none;border-radius:var(--radius-sm);font-family:var(--fd);font-size:15px;font-weight:600;cursor:pointer;letter-spacing:0.02em;transition:all .3s;margin-top:1rem;box-shadow:var(--shadow-glow);}
.cf-btn:hover{background:var(--accent-hover);transform:translateY(-2px);}
.ci{display:flex;align-items:flex-start;gap:1.2rem;margin-bottom:2rem;}
.ci-ico{width:48px;height:48px;border-radius:var(--radius-md);background:var(--accent-light);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.ci-lbl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-light);margin-bottom:4px;}
.ci-val{font-size:15px;color:var(--text-main);font-weight:500;}

/* FOOTER */
footer{background:var(--bg-sec);border-top:1px solid var(--border-light);padding:5rem 5vw 3rem;}
.fi{max-width:1200px;margin:0 auto;}
.fg-top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:4rem;padding-bottom:3rem;border-bottom:1px solid var(--border);}
.flogo{font-family:var(--fd);font-size:20px;font-weight:800;margin-bottom:1rem;color:var(--text-main);}
.flogo span{color:var(--accent);}
.ftag{font-size:14px;color:var(--text-muted);line-height:1.8;margin-bottom:1.5rem;max-width:300px;}
.fcol-tit{font-family:var(--fd);font-size:14px;font-weight:700;color:var(--text-main);margin-bottom:1.5rem;}
.fcol-links{display:flex;flex-direction:column;gap:.8rem;}
.fcol-links a{font-size:14px;color:var(--text-muted);transition:color .2s;}
.fcol-links a:hover{color:var(--accent);}
.fbot{padding-top:2rem;display:flex;align-items:center;justify-content:space-between;font-size:13px;color:var(--text-light);flex-wrap:wrap;gap:1rem;}

/* UTILS */
.toast{position:fixed;bottom:2rem;right:2rem;background:var(--bg-main);border:1px solid var(--border);color:var(--text-main);padding:14px 24px;border-radius:var(--radius-md);font-size:14px;font-weight:500;z-index:9999;opacity:0;transform:translateY(20px);transition:all .4s cubic-bezier(0.16, 1, 0.3, 1);pointer-events:none;box-shadow:var(--shadow-hover);}
.toast.show{opacity:1;transform:translateY(0);}
.fu{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease;}
.fu.visible{opacity:1;transform:translateY(0);}

/* MODAL */
.mo-ov{display:none;position:fixed;inset:0;z-index:500;background:rgba(15, 23, 42, 0.4);align-items:center;justify-content:center;padding:1.5rem;backdrop-filter:blur(8px);}
.mo-ov.open{display:flex;}
.mo-box{background:var(--bg-main);border:1px solid var(--border);border-radius:var(--radius-lg);width:100%;max-width:600px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);transform:scale(0.95);opacity:0;transition:all .3s cubic-bezier(0.16, 1, 0.3, 1);}
.mo-ov.open .mo-box{transform:scale(1);opacity:1;}
.mo-bar{height:4px;background:var(--accent);}
.mo-head{padding:2rem 2rem 1rem;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;}
.mo-icon{font-size:2.5rem;margin-bottom:1rem;background:var(--accent-light);width:60px;height:60px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-md);color:var(--accent);}
.mo-title{font-family:var(--fd);font-size:1.5rem;font-weight:700;color:var(--text-main);margin-bottom:.5rem;}
.mo-tag{font-size:12px;font-weight:600;color:var(--accent);}
.mo-close{background:var(--bg-sec);border:1px solid var(--border);color:var(--text-muted);width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:all .2s;}
.mo-close:hover{background:var(--border-light);color:var(--text-main);}
.mo-body{padding:0 2rem 2rem;}
.mo-desc{font-size:14px;color:var(--text-muted);line-height:1.8;margin-bottom:2rem;}
.mo-feats{display:flex;flex-direction:column;gap:.8rem;margin-bottom:2rem;background:var(--bg-sec);padding:1.5rem;border-radius:var(--radius-md);}
.mo-feat{display:flex;align-items:flex-start;gap:.8rem;font-size:13px;color:var(--text-main);font-weight:500;}
.mo-feat-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:6px;background:var(--accent);}
.mo-cta{background:var(--bg-main);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
.mo-cta-txt{font-family:var(--fd);font-size:14px;font-weight:600;color:var(--text-main);}
.mo-cta-sub{font-size:12px;color:var(--text-muted);margin-top:.2rem;}
.mo-btns{display:flex;gap:1rem;flex-wrap:wrap;}
.mo-btn-main{background:var(--accent);color:#FFFFFF;border:none;padding:12px 20px;border-radius:var(--radius-sm);font-family:var(--fd);font-size:13px;font-weight:600;cursor:pointer;letter-spacing:0.02em;transition:all .2s;box-shadow:var(--shadow-glow);}
.mo-btn-main:hover{background:var(--accent-hover);}
.mo-btn-sec{background:transparent;color:var(--text-main);border:1px solid var(--border);padding:12px 20px;border-radius:var(--radius-sm);font-family:var(--fd);font-size:13px;font-weight:600;cursor:pointer;letter-spacing:0.02em;transition:all .2s;}
.mo-btn-sec:hover{border-color:var(--accent);color:var(--accent);}


/* RESPONSIVE DESIGN */
@media(max-width:1024px){
  .vi, .coi{grid-template-columns:1fr; gap:3.5rem;}
  .fg-top{grid-template-columns:1fr 1fr; gap:3rem;}
  .hero{padding:120px 5vw 60px;}
}

@media(max-width:768px){
  /* Navigation — replaced by hamburger */
  .nav-links{display:none;}
  .nav-hamburger{display:flex;}

  /* Hero Section */
  .hero{padding:100px 5vw 60px; min-height:auto;}
  h1{font-size:clamp(1.9rem, 8vw, 2.6rem); line-height:1.15;}
  .hdesc{font-size:15px; margin-bottom:2rem;}
  .hbtns{flex-direction:column; width:100%; gap:.875rem; margin-bottom:2.5rem;}
  .btn-or,.btn-gh{width:100%; justify-content:center; padding:15px; font-size:15px;}
  .hmetrics{display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; width:100%;}
  .hm{padding:.75rem .5rem; background:var(--bg-sec); border-radius:var(--radius-md); border:1px solid var(--border-light);}
  .hm-val{font-size:1.6rem;}
  .hm-label{font-size:11px;}

  /* Stats band */
  .mbi{grid-template-columns:1fr 1fr; gap:1.5rem 1rem;}
  .mb:not(:last-child)::after{display:none;}
  .mb-val{font-size:2rem;}

  /* Section Padding */
  #services,#vision,#contact{padding:70px 5vw;}
  .stit{font-size:1.9rem;}
  .sdesc{font-size:15px; margin-bottom:2.5rem;}

  /* Services Grid — single column */
  [style*='grid-template-columns']{grid-template-columns:1fr!important;}

  /* Service Cards */
  .sc-body{padding:1.75rem 1.5rem 1.5rem;}
  .sc-footer{padding:1.2rem 1.5rem; flex-direction:column; gap:.875rem; align-items:flex-start;}

  /* Vision */
  .vi{gap:2.5rem;}
  .vc:hover{transform:none;}

  /* Contact */
  .coi{gap:2.5rem;}
  .cf{padding:2rem 1.5rem;}
  .fg{grid-template-columns:1fr;}

  /* Footer */
  .fg-top{grid-template-columns:1fr 1fr; gap:2.5rem;}
  .fbot{flex-direction:column; align-items:center; text-align:center;}

  /* Modal */
  .mo-head{padding:1.5rem 1.5rem 1rem;}
  .mo-body{padding:0 1.5rem 1.5rem;}
  .mo-cta{flex-direction:column; align-items:flex-start;}
  .mo-btns{width:100%; flex-direction:column;}
  .mo-btn-main,.mo-btn-sec{width:100%; justify-content:center; text-align:center;}
}

@media(max-width:480px){
  nav{padding:0 4vw;}
  .nav-name{font-size:15px;}

  h1{font-size:1.95rem;}
  .htag{font-size:10px; padding:5px 14px;}
  .hmetrics{grid-template-columns:1fr 1fr;}

  .mbi{grid-template-columns:1fr;}
  .mb-val{font-size:2.2rem;}

  #services,#vision,#contact{padding:60px 4vw;}
  .stit{font-size:1.75rem;}
  .sdesc{font-size:14px; margin-bottom:2rem;}

  .fg-top{grid-template-columns:1fr; gap:2rem;}
  .fbot{flex-direction:column; align-items:center; text-align:center;}

  /* Photo band hidden on very small screens */
  [style*='grid-template-columns:1.4fr']{display:none;}
}
</style>
</head>
<body>

<nav id="nav">
  <div class="nav-brand">
    <div class="nav-emblem">⚖️</div>
    <div class="nav-name">KAINOS <span>RH</span></div>
  </div>
  <div class="nav-links">
    <a href="#services">Nos services</a>
    <a href="#vision">Notre vision</a>
    <a href="#contact">Contact</a>
    <a href="#contact" class="nav-cta">Parlez-nous de votre projet</a>
  </div>
  <button class="nav-hamburger" id="hamburger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Navigation mobile">
