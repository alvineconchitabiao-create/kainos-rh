        <div class="fcol-tit">Nos services</div>
        <div class="fcol-links">
          <a href="#contact" onclick="ouvrirModal('elite')">🏛️ Elite RH Consulting</a>
          <a href="jobfit.html">🎯 Jobfit</a>
          <a href="services-rh-enligne.html">💻 Votre RH en ligne</a>
          <a href="pae.html">❤️ PAE</a>
          <a href="stratos.html">🚀 STRATOS</a>
        </div>
      </div>
      <div>
        <div class="fcol-tit">Contact</div>
        <div class="fcol-links">
          <a href="tel:+22901993447390">+229 01 99 34 47 39</a>
          <a href="mailto:contact@kainosrh.com">contact@kainosrh.com</a>
          <a href="#contact">Formulaire de contact</a>
        </div>
      </div>
    </div>
    <div class="fbot">
      <span>© 2026 KAINOS RH — Tous droits réservés</span>
      <span>Cotonou, Bénin · Conçu pour les RH africaines</span>
    </div>
  </div>
</footer>

<!-- MODALS -->
<div class="mo-ov" id="modal-overlay" onclick="if(event.target===this)fermerModal()">
  <div class="mo-box">
    <div class="mo-bar" id="mo-bar"></div>
    <div class="mo-head">
      <div>
        <div class="mo-icon" id="mo-icon"></div>
        <div class="mo-title" id="mo-title"></div>
        <div class="mo-tag" id="mo-tag"></div>
      </div>
      <button class="mo-close" onclick="fermerModal()">✕</button>
    </div>
    <div class="mo-body">
      <p class="mo-desc" id="mo-desc"></p>
      <div class="mo-feats" id="mo-feats"></div>
      <div class="mo-cta">
        <div><div class="mo-cta-txt">Intéressé par ce service ?</div><div class="mo-cta-sub">Notre équipe vous répond sous 48h</div></div>
        <div class="mo-btns">
          <button class="mo-btn-main" id="mo-btn-savoir" onclick="allerPage()">En savoir plus →</button>
          <button class="mo-btn-sec" onclick="allerContact()">Parlez-nous de votre projet</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
var PAGE_COURANTE = '#';
var SERVICES = {
  elite:{icon:'🏛️',page:null,color:'#C9A84C',title:'Elite RH Consulting',tag:'CONSEIL · AUDIT · FORMATION',
    desc:'Accompagnement stratégique des dirigeants et DRH dans la transformation de leur fonction RH. Expertise terrain, conformité OHADA et Code du Travail béninois.',
    feats:['Conseil RH stratégique et opérationnel','Audit social et diagnostic RH complet','Formation et développement des équipes','Accompagnement à la transformation RH','DRH à temps partagé']},
  jobfit:{icon:'🎯',page:'jobfit.html',color:'#F05A5A',title:'Jobfit',tag:'RECRUTEMENT · MISE EN RELATION',
    desc:'Jobfit connecte les entreprises aux talents dont elles ont besoin. Recrutement permanent, missions courtes ou mise à disposition dans tous les domaines.',
    feats:['Recrutement cadres et postes clés','Mise en relation consultants/missions','Mise à disposition de personnel','Évaluation et assessment de candidats','Intégration et onboarding']},
  rhenline:{icon:'💻',page:'services-rh-enligne.html',color:'#4A9EFF',title:'Votre RH en ligne',tag:'EXTERNALISATION RH',
    desc:'Externalisez votre gestion RH à nos experts. Paie, déclarations CNSS, congés, contrats — tout géré à distance avec la rigueur d\'un département interne.',
    feats:['Traitement de la paie mensuelle','Déclarations sociales et fiscales','Gestion des congés et absences','Administration du personnel','Veille juridique et conformité']},
  pae:{icon:'❤️',page:'pae.html',color:'#F06292',title:'PAE',tag:'PROGRAMME AIDE AUX EMPLOYÉS',
    desc:'Le PAE de KAINOS RH couvre 9 services autour de 4 axes : santé mentale, développement professionnel, vitalité physique et vie familiale.',
    feats:['Psychologue du travail et gestion du stress','Formation jeunes managers et leadership','Coach sportif et nutritionniste','Garde d\'enfants et voyages organisés','Soins dentaires et bien-être']},
  stratos:{icon:'🚀',page:'stratos.html',color:'#A78BFA',title:'STRATOS',tag:'SAAS RH · DISPONIBLE',
    desc:'STRATOS permet de répartir les objectifs stratégiques par fonction, suivre la contribution de chaque équipe et évaluer l\'apport de chaque collaborateur.',
    feats:['Gestion des OKR et objectifs','Évaluation des performances et feedbacks 360','Budget RH et planification','Analytics et tableau de bord','Accès immédiat sur luxury-manatee-d29c68.netlify.app']}
};

function ouvrirModal(id){
  var s = SERVICES[id];
  if(!s) return;
  PAGE_COURANTE = s.page;
  document.getElementById('mo-bar').style.background = s.color;
  document.getElementById('mo-icon').textContent = s.icon;
  document.getElementById('mo-title').textContent = s.title;
  document.getElementById('mo-tag').textContent = s.tag;
  document.getElementById('mo-tag').style.color = s.color;
  document.getElementById('mo-desc').textContent = s.desc;
  var fl = document.getElementById('mo-feats');
  fl.innerHTML = '';
  s.feats.forEach(function(f){
    var d = document.createElement('div');
    d.className = 'mo-feat';
    d.innerHTML = '<div class="mo-feat-dot" style="background:'+s.color+'"></div><span>'+f+'</span>';
    fl.appendChild(d);
  });
  var btnSavoir = document.getElementById('mo-btn-savoir');
  if(s.page){
    btnSavoir.style.display = '';
    btnSavoir.style.background = s.color;
  } else {
    btnSavoir.style.display = 'none';
  }
  document.getElementById('modal-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function fermerModal(){
  document.getElementById('modal-overlay').classList.remove('open');
  document.body.style.overflow = '';
}

function allerPage(){
  if(PAGE_COURANTE){ fermerModal(); window.location.href = PAGE_COURANTE; }
}

function allerContact(){
  fermerModal();
  document.getElementById('contact').scrollIntoView({behavior:'smooth'});
}

function envoyer(){
  var n=document.getElementById('c-nom').value.trim();
  var t=document.getElementById('c-tel').value.trim();
  if(!n||!t){toast('Nom et téléphone obligatoires.');return;}
  var data={nom:n,entreprise:document.getElementById('c-ent').value.trim(),telephone:t,email:document.getElementById('c-email').value.trim(),service:document.getElementById('c-service').value,message:document.getElementById('c-msg').value.trim(),_subject:'Nouveau message KAINOS RH'};
  toast('Envoi en cours...');
  fetch('https://formspree.io/f/xdaywqpp',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)})
  .then(function(r){return r.json();})
  .then(function(res){
    if(res.ok||res.next){toast('Message envoyé ! Réponse sous 48h.');['c-nom','c-ent','c-tel','c-email','c-service','c-msg'].forEach(function(id){document.getElementById(id).value='';});}
    else{toast('Erreur. Contactez-nous : contact@kainosrh.com');}
  })
  .catch(function(){toast('Erreur réseau.');});
}

window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',window.scrollY>30);});
var obs=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting)x.target.classList.add('visible');});},{threshold:0.1});
document.querySelectorAll('.fu').forEach(function(el){obs.observe(el);});
document.addEventListener('keydown',function(e){if(e.key==='Escape')fermerModal();});
var tt;
function toast(msg){var el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');clearTimeout(tt);tt=setTimeout(function(){el.classList.remove('show');},4500);}
</script>
</body>
</html>
